<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/keyboard_panel"
        android:paddingTop="4dp"
        android:paddingBottom="7dp">

    <TextView
        android:id="@+id/cacheTag"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:textColor="@color/keyboard_text"
        android:textStyle="bold"
        android:textSize="12sp"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/candidateRow"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/candidateScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="horizontal"
            android:fadingEdge="horizontal"
            android:fadeScrollbars="false"
            android:overScrollMode="always">

            <LinearLayout
                android:id="@+id/candidateBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/candidateExpandButton"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:background="@drawable/key_action"
            android:contentDescription="展开候选"
            android:text="⌄"
            android:textColor="@color/keyboard_text"
            android:textSize="17sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/candidateExpansionContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@color/keyboard_panel"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/candidateExpandedScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/candidateExpandedRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/keyboardRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/keyPreview"
        android:layout_width="58dp"
        android:layout_height="66dp"
        android:background="@drawable/key_preview"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:includeFontPadding="false"
        android:paddingBottom="9dp"
        android:textColor="@color/keyboard_text"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
