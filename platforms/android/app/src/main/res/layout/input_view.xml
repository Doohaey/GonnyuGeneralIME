<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#D1D3D6"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="4dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/cacheTag"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:textColor="#636871"
        android:textSize="10sp"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/candidateRow"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/candidateScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="horizontal"
            android:fadingEdge="horizontal"
            android:fadeScrollbars="false"
            android:overScrollMode="always">

            <LinearLayout
                android:id="@+id/candidateBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/candidateExpandButton"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:background="@drawable/key_action"
            android:contentDescription="展开候选"
            android:text="⌄"
            android:textColor="#FF1B1D20"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/candidateExpansionContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/candidateExpandedScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/candidateExpandedRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/candidateMoreButton"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@drawable/key_action"
            android:contentDescription="加载更多候选"
            android:text="加载更多候选"
            android:textColor="#FF1B1D20"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keyboardRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />
</LinearLayout>
