<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp"><shape><corners android:radius="8dp" /><solid android:color="#FFEAF4FB" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp" android:bottom="2dp"><shape><corners android:radius="8dp" /><solid android:color="#FFD1E2F0" /></shape></item>
            <item android:bottom="3dp"><shape><corners android:radius="8dp" /><solid android:color="#FFF8FCFF" /></shape></item>
        </layer-list>
    </item>
</selector>
