{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["input", "candidates"],
  "properties": {
    "input": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "reading": { "type": "string" },
          "tone_class": { "type": "integer", "minimum": 1, "maximum": 7 },
          "register": { "type": "string", "enum": ["wen", "bai", "common"] },
          "scheme": { "type": "string", "enum": ["gon-han", "gon-pin", "mandarin"] },
          "language": { "type": "string", "enum": ["gan", "mandarin"] },
          "coda": { "type": "string", "enum": ["t", "k", "p", ""] },
          "weight": { "type": "number" },
          "priority_tier": { "type": "integer" },
          "hint": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["wen-reading", "bai-reading", "gan-vocab", "mandarin-mark"] },
              "reading": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          "source": { "type": "string" }
        }
      }
    }
  }
}

