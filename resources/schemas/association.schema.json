{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["trigger", "suggestions"],
  "properties": {
    "trigger": { "type": "string" },
    "trigger_kind": { "type": "string", "enum": ["mandarin", "gan-vocab", "gan-fragment"] },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "reading": { "type": "string" },
          "tone_class": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 7 }
          },
          "scheme": { "type": "string", "enum": ["gon-han", "gon-pin"] },
          "relation": { "type": "string" },
          "is_fragment": { "type": "boolean" },
          "weight": { "type": "number" }
        }
      }
    }
  }
}

