{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "grapheme", "readings"],
  "properties": {
    "id": { "type": "string" },
    "grapheme": { "type": "string" },
    "readings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["syllable"],
        "properties": {
          "syllable": { "type": "string" },
          "tone": { "type": "string" },
          "tone_class": { "type": "integer", "minimum": 1, "maximum": 7 },
          "tone_value": { "type": "string" },
          "register": { "type": "string", "enum": ["wen", "bai", "common"] },
          "scheme": { "type": "string", "enum": ["gon-han", "gon-pin"] },
          "coda": { "type": "string", "enum": ["t", "k", "p", ""] },
          "weight": { "type": "number" },
          "priority_tier": { "type": "integer" },
          "source": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
